<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>go-tari-netmap — topology</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="site-title"><a href="/">go-tari-netmap</a></div>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/topology">Topology</a>
      <a href="/submissions">Submissions</a>
    </nav>
  </header>

  <main class="topology-main">
    <p class="tagline">
      Peer topology graph. Node labels show a truncated, non-identifying
      pubkey prefix (or "unconfirmed") — never a real address, even for
      nodes that have opted in to showing an address on the dashboard.
    </p>

    <div class="graph-legend">
      <span class="legend-item"><span class="legend-dot legend-dot-onion"></span>onion-capable</span>
      <span class="legend-item"><span class="legend-dot legend-dot-clearnet"></span>clearnet-only</span>
      <span class="legend-item"><span class="legend-dot legend-dot-unconfirmed"></span>unconfirmed</span>
    </div>

    <div id="graph-status" class="empty-note"></div>
    <div id="graph"></div>
  </main>

  <script>
    (function () {
      // Privacy note: this page NEVER renders a node's `address` field,
      // even when GET /api/topology's already-scrubbed response includes
      // one for an opted-in (registry_submitted) node — the dashboard
      // table is the place for that. This graph is about topology shape
      // and capability only, so `address` is intentionally never read
      // below.

      var COLOR_ONION = '#b79bf0';
      var COLOR_CLEARNET = '#5aa9ff';
      var COLOR_UNCONFIRMED = '#8a94a6';

      // shortLabel derives a short, non-identifying display label for a
      // node from the JSON API's `public_key` field. Go's encoding/json
      // encodes a []byte (PublicNode.PublicKey) as a base64 string, and
      // omits the field entirely (via `omitempty`) when the node has no
      // confirmed pubkey yet — so publicKeyB64 is undefined/null/absent
      // for unconfirmed placeholder nodes, not just an empty string.
      function shortLabel(publicKeyB64) {
        if (!publicKeyB64) {
          return 'unconfirmed';
        }
        // Truncate the base64 string itself rather than decoding to hex —
        // simpler, and equally non-identifying at a glance (still clearly
        // NOT an address, and never the full raw key).
        var short = publicKeyB64.length > 12 ? publicKeyB64.slice(0, 12) : publicKeyB64;
        return short + '\u2026';
      }

      function nodeColor(n) {
        if (!n.public_key) {
          return COLOR_UNCONFIRMED;
        }
        if (n.has_onion) {
          return COLOR_ONION;
        }
        return COLOR_CLEARNET;
      }

      function nodeShape(n) {
        if (!n.public_key) {
          return 'dot';
        }
        return n.has_onion ? 'diamond' : 'dot';
      }

      var statusEl = document.getElementById('graph-status');

      fetch('/api/topology')
        .then(function (resp) {
          if (!resp.ok) {
            throw new Error('GET /api/topology: ' + resp.status);
          }
          return resp.json();
        })
        .then(function (payload) {
          var apiNodes = payload.nodes || [];
          var apiEdges = payload.edges || [];

          if (apiNodes.length === 0) {
            statusEl.textContent = 'No nodes known yet.';
            return;
          }
          statusEl.textContent = '';

          var visNodes = apiNodes.map(function (n) {
            return {
              id: n.id,
              label: shortLabel(n.public_key),
              title: n.public_key ? 'pubkey (base64, truncated above): ' + n.public_key : 'unconfirmed node',
              color: nodeColor(n),
              shape: nodeShape(n),
            };
          });

          var visEdges = apiEdges.map(function (e) {
            return {
              id: e.id,
              from: e.from_node_id,
              to: e.to_node_id,
              arrows: 'to',
            };
          });

          var container = document.getElementById('graph');
          var data = {
            nodes: new vis.DataSet(visNodes),
            edges: new vis.DataSet(visEdges),
          };
          var options = {
            nodes: {
              borderWidth: 1,
              font: { color: '#e4e8ee' },
            },
            edges: {
              color: { color: '#2a323f', highlight: '#5aa9ff' },
              smooth: { type: 'continuous' },
            },
            physics: {
              stabilization: true,
            },
            interaction: {
              hover: true,
            },
          };
          new vis.Network(container, data, options);
        })
        .catch(function (err) {
          statusEl.textContent = 'Failed to load topology: ' + err;
        });
    })();
  </script>
</body>
</html>
