<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>go-tari-netmap — full network</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="site-header">
    <div class="site-title"><a href="/">go-tari-netmap</a></div>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/topology">Topology</a>
      <a href="/network">Full Network</a>
    </nav>
  </header>

  <main>
    <p class="tagline">
      The complete, unfiltered node population — every known node,
      including nodes that haven't been reachable recently (or ever).
      For the dashboard's reachable-within-24h view, see the main
      Dashboard page instead.
    </p>

    <section>
      <h2>Summary</h2>
      <div class="card-grid">
        <div class="card">
          <div class="card-label">Total nodes</div>
          <div class="card-value">{{.Counts.Total}}</div>
        </div>
        <div class="card">
          <div class="card-label">Confirmed</div>
          <div class="card-value">{{.Counts.Confirmed}}</div>
          <div class="card-sub">{{.Counts.Unconfirmed}} unconfirmed</div>
        </div>
        <div class="card">
          <div class="card-label">Onion-capable</div>
          <div class="card-value">{{.Counts.OnionCapable}}</div>
        </div>
        <div class="card">
          <div class="card-label">Clearnet-only</div>
          <div class="card-value">{{.Counts.ClearnetOnly}}</div>
        </div>
        <div class="card">
          <div class="card-label">Network height</div>
          {{if .NetworkHeight}}
          <div class="card-value">{{.NetworkHeight}}</div>
          <div class="card-sub">(from {{.NetworkHeightNodeCount}} nodes)</div>
          {{else}}
          <div class="card-value">unknown</div>
          {{end}}
        </div>
      </div>
    </section>

    <section>
      <h2>Nodes</h2>
      <table>
        <thead>
          <tr>
            <th>Identity</th>
            <th>Capabilities</th>
            <th>Address</th>
            <th>Discovery source</th>
            <th>Most recent probe, reachable</th>
            <th>Height</th>
          </tr>
        </thead>
        <tbody>
          {{range .Nodes}}
          <tr>
            <td>
              <a href="/nodes/{{.ID}}">
                {{if .Identity.Confirmed}}
                <span class="pubkey" title="{{.Identity.FullHex}}">{{.Identity.ShortHex}}</span>
                {{else}}
                <span class="badge badge-unconfirmed">unconfirmed</span>
                {{end}}
              </a>
              {{if .LikelyDead}}
              <span class="badge badge-likely-dead">likely dead</span>
              {{end}}
            </td>
            <td>
              <span class="capabilities">
                {{if or .Capabilities.HasIPv4 .Capabilities.HasIPv6}}<span class="badge badge-clearnet">clearnet</span>{{end}}
                {{if .Capabilities.HasOnion}}<span class="badge badge-onion">onion</span>{{end}}
                {{if and (or .Capabilities.HasIPv4 .Capabilities.HasIPv6) .Capabilities.HasOnion}}<span class="badge badge-dualstack">dual-stack</span>{{end}}
              </span>
            </td>
            <td>
              {{if .PublicAddresses}}
              {{range .PublicAddresses}}<span class="public-address">{{.}}</span><br>{{end}}
              <span class="badge badge-registry">opted-in</span>
              {{end}}
            </td>
            <td>{{.DiscoverySource}}</td>
            <td>
              {{if .LatestHealth}}
              {{.LatestHealth.Timestamp}}
              {{if .LatestHealth.Reachable}}
              <span class="badge badge-reachable">reachable</span>
              {{else}}
              <span class="badge badge-unreachable">unreachable</span>
              {{end}}
              {{if .LatestHealth.Version}}{{.LatestHealth.Version}}{{else}}—{{end}}
              {{else}}
              —
              {{end}}
            </td>
            <td>{{if .LatestHealth}}{{if .LatestHealth.Height}}{{.LatestHealth.Height}}{{else}}—{{end}}{{else}}—{{end}}</td>
          </tr>
          {{else}}
          <tr><td colspan="6" class="empty-note">No nodes known yet.</td></tr>
          {{end}}
        </tbody>
      </table>
      <div class="pagination">
        <span class="panel-note">
          {{if .NodeTotal}}Showing {{.NodeRangeStart}}-{{.NodeRangeEnd}} of {{.NodeTotal}} nodes{{else}}No nodes known yet.{{end}}
        </span>
        <span class="pagination-links">
          {{if .HasPrevPage}}<a href="/network?page={{.PrevPage}}">Prev</a>{{else}}<span class="pagination-disabled">Prev</span>{{end}}
          {{if .HasNextPage}}<a href="/network?page={{.NextPage}}">Next</a>{{else}}<span class="pagination-disabled">Next</span>{{end}}
        </span>
      </div>
    </section>
  </main>
</body>
</html>
