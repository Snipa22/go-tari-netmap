<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>go-tari-netmap — {{if .Identity.Confirmed}}{{.Identity.ShortHex}}{{else}}unconfirmed node{{end}}</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="site-header">
    <div class="site-title"><a href="/">go-tari-netmap</a></div>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/topology">Topology</a>
      <a href="/network">Full Network</a>
    </nav>
  </header>

  <main>
    <a class="back-link" href="/">&larr; back to dashboard</a>

    <h1>
      {{if .Identity.Confirmed}}
      <span class="pubkey" title="{{.Identity.FullHex}}">{{.Identity.ShortHex}}</span>
      {{else}}
      <span class="badge badge-unconfirmed">unconfirmed</span>
      {{end}}
      {{if .LikelyDead}}
      <span class="badge badge-likely-dead">likely dead</span>
      {{end}}
    </h1>

    <section class="detail-summary">
      <dl>
        <dt>Known transports</dt>
        <dd>
          {{if or .Capabilities.HasIPv4 .Capabilities.HasIPv6 .Capabilities.HasOnion}}
          {{if or .Capabilities.HasIPv4 .Capabilities.HasIPv6}}clearnet{{end}}
          {{if .Capabilities.HasOnion}}onion{{end}}
          {{if and (or .Capabilities.HasIPv4 .Capabilities.HasIPv6) .Capabilities.HasOnion}}<span class="badge badge-dualstack">dual-stack</span>{{end}}
          {{else}}
          none observed yet
          {{end}}
        </dd>

        {{if .PublicAddresses}}
        <dt>Address</dt>
        <dd>
          {{if gt (len .PublicAddresses) 1}}
          <ul class="public-address-list">
            {{range .PublicAddresses}}<li><span class="public-address">{{.}}</span></li>{{end}}
          </ul>
          {{else}}
          {{range .PublicAddresses}}<span class="public-address">{{.}}</span>{{end}}
          {{end}}
          <span class="badge badge-registry">opted in via registry</span>
        </dd>
        {{end}}

        <dt>Discovery source</dt>
        <dd>{{.Node.DiscoverySource}}</dd>

        <dt>Tags</dt>
        <dd>{{.Node.Tags}}</dd>

        <dt>Label</dt>
        <dd>{{if .Node.Label}}{{.Node.Label}}{{else}}—{{end}}</dd>

        <dt>First seen</dt>
        <dd>{{.Node.FirstSeen}}</dd>

        <dt>Last seen</dt>
        <dd>{{.Node.LastSeen}}</dd>

        <dt>Identity last updated</dt>
        <dd>{{if .IdentityUpdatedAt}}{{.IdentityUpdatedAt}}{{else}}—{{end}}</dd>

        <dt>Last known version</dt>
        <dd>{{if .LastKnownVersion}}{{.LastKnownVersion}}{{else}}—{{end}}</dd>
      </dl>
    </section>

    <section>
      <h2>Recent history</h2>
      <table>
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Reachable</th>
            <th>Height</th>
            <th>Latency (ms)</th>
            <th>Identity updated</th>
          </tr>
        </thead>
        <tbody>
          {{range .RecentSuccessfulChecks}}
          <tr>
            <td>{{.Timestamp}}</td>
            <td>{{.Reachable}}</td>
            <td>{{if .Height}}{{.Height}}{{else}}—{{end}}</td>
            <td>{{if .LatencyMS}}{{.LatencyMS}}{{else}}—{{end}}</td>
            <td>{{if .PeerIdentityUpdatedAt}}{{.PeerIdentityUpdatedAt}}{{else}}—{{end}}</td>
          </tr>
          {{else}}
          <tr><td colspan="5" class="empty-note">No health checks recorded yet.</td></tr>
          {{end}}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Peer connections</h2>
      <table>
        <thead>
          <tr>
            <th>Direction</th>
            <th>Peer identity</th>
            <th>First seen</th>
            <th>Last seen</th>
          </tr>
        </thead>
        <tbody>
          {{range .PeerEdges}}
          <tr>
            <td>{{.Direction}}</td>
            <td>
              {{if .OtherIdentity.Confirmed}}
              <span class="pubkey" title="{{.OtherIdentity.FullHex}}">{{.OtherIdentity.ShortHex}}</span>
              {{else}}
              <span class="badge badge-unconfirmed">unconfirmed</span>
              {{end}}
            </td>
            <td>{{.FirstSeen}}</td>
            <td>{{.LastSeen}}</td>
          </tr>
          {{else}}
          <tr><td colspan="4" class="empty-note">No peer connections observed yet.</td></tr>
          {{end}}
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
